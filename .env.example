# Generate a fresh one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production

# DEBUG MUST be False in production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host list — Django requires this in prod
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Dev default — SQLite needs no setup
DB_ENGINE=django.db.backends.sqlite3

# Production (Postgres / MySQL) example
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=stockapp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
