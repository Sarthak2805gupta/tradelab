# Generate a fresh one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production

# DEBUG MUST be False in production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host list — Django requires this in prod
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Dev default — SQLite needs no setup
DB_ENGINE=django.db.backends.sqlite3

# Production (Postgres / MySQL) example
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=stockapp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Cache backend: "db" (shared, survives restarts; table created by `migrate`)
# or "locmem" (per-process, zero setup).
CACHE_BACKEND=db
# Keep dashboard quotes warm from a background thread while the server runs.
PREWARM_IN_PROCESS=true
# Gunicorn sizing (Procfile): 1 worker x 8 threads fits a 512 MB instance.
WEB_WORKERS=1
WEB_THREADS=8
